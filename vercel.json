{
  "version": 2,
  "builds": [
    { "src": "public/index.php", "use": "@vercel/php" },
    { "src": "public/build/(.*)", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/build/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "dest": "/public/build/$1" },
    { "src": "/(.*)", "dest": "/public/index.php" }
  ]
}